{
  "id": "axon",
  "name": "Axon",
  "description": "macOS desktop automation — control apps via Accessibility API, AppleScript, and screenshots",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "serverUrl": {
        "type": "string",
        "description": "Axon server base URL",
        "default": "http://127.0.0.1:29170"
      },
      "authToken": {
        "type": "string",
        "description": "Bearer token for Axon server authentication"
      },
      "autoStart": {
        "type": "boolean",
        "description": "Automatically start Axon server when plugin loads",
        "default": false
      }
    }
  },
  "uiHints": {
    "authToken": {
      "label": "Auth Token",
      "sensitive": true,
      "placeholder": "UUID from ~/.config/axon/auth-token",
      "help": "Auto-read from ~/.config/axon/auth-token if not set"
    }
  }
}
